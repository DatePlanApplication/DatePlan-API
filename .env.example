# Copie para .env (ignorado pelo git) e preencha. NUNCA faça commit do .env.

# JWT
SECRET=troque-por-um-valor-aleatorio-com-pelo-menos-32-bytes
ISSUER=dateplan-api
AUDIENCE=dateplan-app

# Argon2id (padrões do Spring Security; memória em KB)
SALT_LENGTH=16
HASH_LENGTH=32
PARALLELISM=1
MEMORY=16384
ITERATIONS=2

# Redis
REDIS_URL=redis://localhost:6379

# JSON da service account do Firebase (guarde FORA do repositório)
FIREBASE_JSON_PATH=file:/caminho/seguro/firebase.json

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/dateplan
DB_USERNAME=dateplan
DB_PASSWORD=dateplan
